#name of the stack
COMPOSE_PROJECT_NAME=mcp-inspector

#local development only — there is no production overlay, and none is wanted
#(the Inspector spawns processes and holds tokens for every server you add)

#user that owns ../data on the host
USER_ID=1000
GROUP_ID=1000

#images versions to use
NGINX_VERSION=latest
MCP_INSPECTOR_VERSION=2.9.0

#domain where you open the UI; add it to the hosts file (Windows: C:\Windows\System32\drivers\etc\hosts)
DOMAIN_HOST=mcp-inspector.local
SELF_SIGNED_HOST=mcp-inspector.local

#where the shared nginx-proxy lives, relative to scripts/ — its CA is mounted from there
NGINX_PROXY_PATH=../../nginx-proxy

#hosts of the MCP servers you add in the UI, comma separated; each is mapped to the host
#gateway, so a `.local` name reaches nginx-proxy instead of the container's own loopback.
#Not needed for public domains. Apply with `sh scripts/start.sh` (not restart.sh).
MCP_SERVER_HOSTS=

#Basic Auth in front of the UI; start.sh turns these into nginx/.htpasswd
MCP_INSPECTOR_UI_USERNAME=admin
MCP_INSPECTOR_UI_PASSWORD=

#token the UI needs in its URL (?MCP_INSPECTOR_API_TOKEN=...); fixed so a bookmark survives
#restarts, empty = a random one printed in the mcp-inspector-app logs at every start
#   openssl rand -hex 32
MCP_INSPECTOR_API_TOKEN=
